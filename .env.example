# Solana RPC endpoint used for reading wallet balances (sync) and SOL balance.
# The public default (api.mainnet-beta.solana.com) is heavily rate-limited and
# will frequently fail with "Sync failed" in the app. Get a free dedicated
# endpoint instead — e.g. https://helius.dev (free tier, no credit card) or
# https://www.quicknode.com — and paste your HTTPS RPC URL below.
VITE_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Wallet address(es) that unlock the admin dashboard (/admin) when connected via
# Phantom or Solflare. Separate several addresses with commas. These are public
# addresses, not secrets — fine to ship in the JS bundle. NOTE: this app has no
# backend, so this only hides/shows UI for convenience — it is not real access
# control. Anyone with devtools can still inspect or alter client-side state.
VITE_ADMIN_WALLET=YOUR_WALLET_ADDRESS,ANOTHER_ADMIN_ADDRESS

# Optional: extra wallets whose Meteora launches should also appear in Launches.
# VITE_LAUNCH_CREATORS=

# --- "Create a token" (ClawPump) — SERVER-SIDE ONLY, no VITE_ prefix on purpose ---
# These never reach the browser bundle. They're read by api/_clawpump.js: by `npm run dev`
# locally, and by the Vercel function in production (set them in the Vercel project settings).
# Your ClawPump key from https://clawpump.tech/dashboard/api, and the agent launches run under
# (create one in the ClawPump dashboard; its id goes here).
CLAWPUMP_API_KEY=
CLAWPUMP_AGENT_ID=
CLAWPUMP_AGENT_NAME=NDCC
